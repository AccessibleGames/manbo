if(EXISTS "${root}/data/official-samples/catalog.json")
  set(owned_corpus "${CMAKE_CURRENT_BINARY_DIR}/cli-frames/owned-corpus")
  file(MAKE_DIRECTORY "${owned_corpus}")
  file(COPY "${root}/data/official-samples/" DESTINATION "${owned_corpus}")
  run(0 search printf --data "${owned_corpus}" --json)
  string(JSON count LENGTH "${OUT}")
  if(NOT count EQUAL 3)
    message(FATAL_ERROR "Offline POSIX/GNU/Linux candidates were not kept distinct")
  endif()
  run(0 man 3 printf --data "${owned_corpus}" --json)
  string(JSON family GET "${OUT}" family)
  if(NOT family STREQUAL "linux-man")
    message(FATAL_ERROR "Explicit section read did not use the real Linux-man adapter")
  endif()
  run(0 read "socket(3p)" --data "${owned_corpus}")
  if(NOT OUT MATCHES "SOCK_STREAM" OR OUT MATCHES "<HTML|<html")
    message(FATAL_ERROR "Plain offline reads must use semantic document text")
  endif()
  file(SHA256 "${owned_corpus}/catalog.json" catalog_before)
  run(1 snapshot printf --reader --data "${owned_corpus}" --output "${owned_corpus}/catalog.json")
  file(SHA256 "${owned_corpus}/catalog.json" catalog_after)
  if(NOT catalog_before STREQUAL catalog_after)
    message(FATAL_ERROR "Snapshot damaged an owned source catalog")
  endif()
  run(0 snapshot "printf(3)" --reader --data "${owned_corpus}" --output "${CMAKE_CURRENT_BINARY_DIR}/cli-frames/official-man.html")
  run(0 search --json)
  string(JSON count LENGTH "${OUT}")
  if(EXISTS "${root}/data/library/catalog.json")
    if(count LESS 2)
      message(FATAL_ERROR "Default discovery should use the imported library plus manbo(1)")
    endif()
  elseif(NOT count EQUAL 9)
    message(FATAL_ERROR "Default discovery should use eight installed originals plus manbo(1)")
  endif()
endif()
message(STATUS "CLI, command manual, offline corpus, and safe output checks passed")

