# Legacy deterministic CLI cases explicitly request demonstration samples.
set(sample_flag --samples)
function(run expected_code)
  execute_process(COMMAND "${MANBO_EXE}" ${sample_flag} ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8)
  if(NOT "${code}" STREQUAL "${expected_code}")
    message(FATAL_ERROR "Command ${ARGN}: expected ${expected_code}, got ${code}\n${output}\n${error}")
  endif()
  set(OUT "${output}" PARENT_SCOPE)
  set(ERR "${error}" PARENT_SCOPE)
endfunction()

